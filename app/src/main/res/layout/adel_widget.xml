<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="7dp"
    android:background="#991A1F16"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/title_project_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="1dp"
        android:text="تسک‌های پروژه ▶"
        android:textColor="#FFB8D48A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout android:id="@+id/row_pt1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/project_task_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/project_task_1_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_pt2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/project_task_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/project_task_2_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_pt3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/project_task_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/project_task_3_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/title_tunnel_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="1dp"
        android:text="تسک‌های تونل ▶"
        android:textColor="#FFB8D48A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout android:id="@+id/row_tt1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tunnel_task_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tunnel_task_1_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_tt2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tunnel_task_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tunnel_task_2_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_tt3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tunnel_task_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tunnel_task_3_done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="انجام" android:textColor="#FF8FCB5A" android:textSize="13sp" android:padding="4dp" android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/title_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="1dp"
        android:text="برنامه کاری پیش‌رو"
        android:textColor="#FFB8D48A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView android:id="@+id/upcoming_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/upcoming_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/upcoming_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE8EDE0" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />

    <!-- دکمه‌ها پایین ویجت -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/btn_daily_report"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_margin="2dp"
            android:background="#FF3D5A3A"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="گزارش روزانه" />

        <TextView
            android:id="@+id/btn_project_register"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_margin="2dp"
            android:background="#FF4A6B3A"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="ثبت پروژه" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_shafts_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:paddingTop="2dp">
        <TextView android:id="@+id/widget_shaft_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شفت ۱" android:textColor="#FF8FCB5A" android:textSize="12sp" android:padding="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" / " android:textColor="#FF7A8570" android:textSize="12sp" />
        <TextView android:id="@+id/widget_shaft_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شفت ۲" android:textColor="#FF8FCB5A" android:textSize="12sp" android:padding="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" / " android:textColor="#FF7A8570" android:textSize="12sp" />
        <TextView android:id="@+id/widget_shaft_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شفت ۳" android:textColor="#FF8FCB5A" android:textSize="12sp" android:padding="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" / " android:textColor="#FF7A8570" android:textSize="12sp" />
        <TextView android:id="@+id/widget_shaft_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شفت ۴" android:textColor="#FF8FCB5A" android:textSize="12sp" android:padding="4dp" />
    </LinearLayout>

</LinearLayout>
